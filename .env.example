# =============================================================================
#  OPS_Native_AI — Single environment file for ALL components
#  Copy to .env and fill in real values.
#  This one file is shared by:
#    OPS_Analytic_Agent / Text2SQL_Agent / OPS_Writer_Agent
#    MultiAgent_Briefing / Onboarding_Server
# =============================================================================

# ── Databricks workspace ──────────────────────────────────────────────────────
DATABRICKS_HOST=https://adb-3315409667346998.18.azuredatabricks.net
DATABRICKS_SQL_WAREHOUSE_ID=

# LLM model served on Databricks (used by Writer & Text2SQL agents)
DATABRICKS_LLM_MODEL=databricks-claude-sonnet-4-6

# ── Databricks auth — choose ONE option ──────────────────────────────────────
# Option 1: Personal Access Token (simplest — good for local use)
DATABRICKS_PAT_TOKEN=dapi...

# Option 2: Azure Service Principal (recommended for scheduled/automated use)
# If CLIENT_ID + CLIENT_SECRET are set, PAT is ignored automatically.
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# DATABRICKS_AZURE_TENANT_ID=374f8026-7b54-4a3a-b87d-328fa26ec10d

# ── Databricks tables (defaults match TomTom production — only change if needed)
# COMBINED_TABLE=mo_occ_reporting.manual_efficiency.manual_efficiency_quality_all_weekly_tbl
# QCA_TABLE=mo_occ_reporting.manual_efficiency.qca_efficiency_tbl
# DELIVERABLE_TABLE=maps_operations_published_catalog.orbit_sd_gold.orbit_sd_maps_deliverable_agg_vw
# PENDING_TASK_TABLE=mo_occ_reporting.manual_efficiency.project_pending_task_tbl

# ── Jira ──────────────────────────────────────────────────────────────────────
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=lalit.patkar@tomtom.com
JIRA_API_TOKEN=

# ── Teams delivery (optional) ─────────────────────────────────────────────────
# Teams channel → "..." → Workflows → "Post to channel when webhook request received"
TEAMS_WEBHOOK_URL=

# ── Microsoft Graph OAuth (Onboarding Server) ─────────────────────────────────
# Azure AD app registration — grants Mail.Read, Chat.Read, Calendars.Read per user
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=374f8026-7b54-4a3a-b87d-328fa26ec10d
GRAPH_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# ── Slack OAuth (Onboarding Server) ──────────────────────────────────────────
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/auth/slack/callback

# ── Server settings ───────────────────────────────────────────────────────────
PORT=8010
LOG_LEVEL=INFO
